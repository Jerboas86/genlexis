{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "genlexis",
	"compatibility_date": "2026-04-28",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	// Wraps the adapter's `_worker.js` so the Worker can also answer a cron.
	"main": "worker.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "genlexis.com",
			"custom_domain": true
		},
		{
			"pattern": "www.genlexis.com",
			"custom_domain": true
		}
	],
	"vars": {
		"ORIGIN": "https://genlexis.com"
	},
	// Workers Logs. The draw route writes one structured line per outcome —
	// served, refused with its code, unauthorized, failed — and these lines are
	// the service's metrics until it has better ones. Without this they exist
	// only for whoever is running `wrangler tail` at the time.
	"observability": { "enabled": true },
	// Daily, at a quiet hour: the idempotency ledger's lapsed entries.
	"triggers": { "crons": ["23 3 * * *"] },
	// Drives the generated env types and warns in local dev when one is missing.
	// It does not gate a deploy, so a name may be listed before it is provisioned.
	"secrets": {
		"required": [
			"PRIVATE_DATABASE_URL",
			// The server-to-server credentials of the material contract. The two
			// `_PREVIOUS` names are absent on purpose: they exist only during a
			// rotation, and listing them would warn on every ordinary run.
			"PRIVATE_MATERIAL_API_TOKEN",
			"PRIVATE_MATERIAL_SIGNING_SECRET"
		]
	},
	"workers_dev": true,
	"preview_urls": true,

	// The non-production environment, deployed as the Worker `genlexis-stg`. It
	// exists to prove the material contract against a real endpoint before
	// anything is served to a patient — the compatibility gate of lot 8 — not to
	// receive public traffic.
	//
	// Its Doppler config points at the shared dev/stg/test database branch, which
	// is where the finished corpus lives.
	"env": {
		"stg": {
			// `routes` is an inheritable key, so leaving it out would NOT mean "no
			// routes": this Worker would inherit the two production domains above.
			// Overriding it is what stops that.
			//
			// It is a custom domain on genlexis.com rather than the workers.dev
			// hostname it first had, because the consumer calling it is itself a
			// Worker. Cloudflare refuses a global fetch() from one Worker to another
			// on the same zone, and workers.dev is one zone: the staging consumer's
			// requests never reached this Worker and were answered 404 by the edge.
			// A domain on this zone makes the staging pair cross-zone — which is
			// exactly what production is, helixum.app calling genlexis.com — so the
			// smoke proves the same topology it will run in.
			"routes": [{ "pattern": "stg.genlexis.com", "custom_domain": true }],
			// `vars` is not inherited. Without this, ORIGIN is undefined here, and
			// better-auth builds its cookies from it.
			"vars": { "ORIGIN": "https://stg.genlexis.com" },
			// Not inherited either. Repeated so a missing secret still warns here.
			"secrets": {
				"required": [
					"PRIVATE_DATABASE_URL",
					"PRIVATE_MATERIAL_API_TOKEN",
					"PRIVATE_MATERIAL_SIGNING_SECRET"
				]
			}
		}
	}
}
