{
	"name": "genlexis",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "doppler run -p genlexis -c dev -- vite dev",
		"build": "vite build",
		"deploy": "wrangler deploy",
		"build:stg": "doppler run -p genlexis -c stg -- pnpm build",
		"build:prod": "doppler run -p genlexis -c prod -- pnpm build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "playwright install && pnpm gen && svelte-kit sync || echo ''",
		"check": "doppler run -p genlexis -c dev -- pnpm check:raw",
		"check:raw": "svelte-kit sync && pnpm generated:postprocess && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && pnpm generated:postprocess && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "doppler run -p genlexis -c test -- vitest",
		"test": "doppler run -p genlexis -c test -- pnpm test:run",
		"test:run": "vitest --run && playwright test",
		"test:e2e": "doppler run -p genlexis -c test -- playwright test",
		"gen": "wrangler types && pnpm generated:postprocess",
		"generated:postprocess": "node scripts/postprocess-generated-files.mjs",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
		"db:push": "drizzle-kit push",
		"db:push:dev": "doppler run -p genlexis -c dev -- pnpm db:push",
		"db:generate": "drizzle-kit generate",
		"db:generate:dev": "doppler run -p genlexis -c dev -- pnpm db:generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:dev": "doppler run -p genlexis -c dev -- pnpm db:migrate",
		"db:migrate:prod": "doppler run -p genlexis -c prod -- pnpm db:migrate",
		"db:studio": "drizzle-kit studio",
		"db:studio:dev": "doppler run -p genlexis -c dev -- pnpm db:studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.15.2",
		"@neondatabase/serverless": "^1.0.2",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"better-auth": "~1.4.21",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0",
		"wrangler": "^4.81.0"
	}
}
