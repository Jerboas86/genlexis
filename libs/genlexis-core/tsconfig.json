{
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"allowJs": false,
		"checkJs": false
	},
	"include": ["src/**/*.ts"]
}
