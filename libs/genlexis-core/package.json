{
	"name": "@genlexis/core",
	"version": "0.1.0",
	"description": "Sentence generation and phoneme-balancing engine for Genlexis.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jerboas86/genlexis.git",
		"directory": "libs/genlexis-core"
	},
	"engines": {
		"node": ">=20"
	},
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./adapters/drizzle": {
			"types": "./dist/adapters/index.d.ts",
			"import": "./dist/adapters/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"provenance": true
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"test": "vitest --run",
		"test:pack": "node scripts/pack-test.mjs"
	},
	"peerDependencies": {
		"drizzle-orm": ">=0.30.0"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		}
	},
	"devDependencies": {
		"drizzle-orm": "^0.45.2",
		"typescript": "^5.6.0"
	}
}
